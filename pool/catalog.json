   }
  },
  "us_vix": {
   "group": "us_close",
   "due": "06:05",
   "sources": [
    "FinMind:USStockPrice?data_id=^VIX"
   ],
   "fields": {
    "close": "",
    "chg": ""
   }
  },
  "us_yield": {
   "group": "us_close",
